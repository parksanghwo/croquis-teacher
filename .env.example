# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# 서버(npm start)가 시작할 때 읽습니다. API 키는 서버에만 있고 브라우저로 보내지지 않습니다.

# 화살표를 클릭하면 이 키로 선화를 추출한 뒤 겹칩니다. 비우면 원본을 그대로 겹칩니다.
OPENAI_API_KEY=sk-...

# 선화 추출에 쓰는 이미지 모델 (비우면 gpt-image-2.6-flare)
OPENAI_IMAGE_MODEL=

# 빨간펜 교정을 분석해 교정 기록 표를 만드는 모델 (비우면 gpt-6-luna)
OPENAI_MODEL=

# (테스트용) Pinterest로 취급할 호스트 목록. 보통은 비워 두세요 (기본 pinterest.com,pinimg.com)
PINTEREST_HOSTS=

# OpenAI 호환 프록시를 쓸 때만 (비우면 https://api.openai.com/v1)
OPENAI_BASE_URL=
